# Groq — free API key at https://console.groq.com
GROQ_API_KEY=
GROQ_CHAT_MODEL=qwen/qwen3-32b

# Local embedding model (HuggingFace sentence-transformers, no API key needed)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# Azure AI Search (free F0 tier) — vector store
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX_NAME=investor-intelligence

# Azure Cosmos DB (NoSQL API) — KPI storage
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=investor_intelligence
COSMOS_CONTAINER=financial_metrics
